# DELETE THE CURRENT project-structure.txt file
# PASTE THIS CODE IN THE TERMINAL TO GET THE UPDATED PROJECT STRUCTURE BEFORE PUSHING

$exclude = @(
    "node_modules", ".git", "dist",
    "build", ".next", ".venv", "__pycache__", "venv"
)

function Show-Tree($path, $prefix = "") {
    $items = Get-ChildItem -LiteralPath $path -Force |
        Where-Object { $_.Name -notin $exclude } |
        Sort-Object @{Expression = { -not $_.PSIsContainer }}, Name

    foreach ($item in $items) {
        "$prefix|-- $($item.Name)"

        if ($item.PSIsContainer) {
            Show-Tree $item.FullName "$prefix|   "
        }
    }
}

Show-Tree (Get-Location).Path |
Out-File "project-structure.txt" -Encoding utf8